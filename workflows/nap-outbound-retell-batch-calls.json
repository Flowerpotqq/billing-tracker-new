    {
      "parameters": {
        "jsCode": "const requestBody = $json.body || $json;\nconst contacts = requestBody.contacts;\n\nif (!Array.isArray(contacts)) {\n  return [{\n    json: {\n      ok: false,\n      statusCode: 400,\n      error: 'Request must include contacts as an array.',\n      invalidRows: []\n    }\n  }];\n}\n\nif (contacts.length === 0) {\n  return [{\n    json: {\n      ok: false,\n      statusCode: 400,\n      error: 'Contacts array cannot be empty.',\n      invalidRows: []\n    }\n  }];\n}\n\nconst normalizePhone = (value) => String(value || '').trim().replace(/[\\s().-]/g, '');\nconst invalidRows = [];\nconst tasks = [];\n\ncontacts.forEach((contact, index) => {\n  const phoneNumber = normalizePhone(contact.phoneNumber || contact.phone_number || contact.phone || contact.number);\n  const firstName = String(contact.firstName || contact.first_name || '').trim();\n  const lastName = String(contact.lastName || contact.last_name || '').trim();\n  const fullName = `${firstName} ${lastName}`.trim();\n\n  if (!phoneNumber) {\n    invalidRows.push({ row: index + 1, reason: 'Missing phone number.' });\n    return;\n  }\n\n  if (!/^\\+[1-9]\\d{6,14}$/.test(phoneNumber)) {\n    invalidRows.push({\n      row: index + 1,\n      phoneNumber,\n      reason: 'Phone number must be E.164 format, for example +14165551234.'\n    });\n    return;\n  }\n\n  tasks.push({\n    to_number: phoneNumber,\n    retell_llm_dynamic_variables: {\n      first_name: firstName,\n      last_name: lastName,\n      name: fullName\n    },\n    metadata: {\n      source: 'nap-dashboard-csv',\n      first_name: firstName,\n      last_name: lastName\n    }\n  });\n});\n\nif (invalidRows.length > 0) {\n  return [{\n    json: {\n      ok: false,\n      statusCode: 400,\n      error: 'Some contacts are invalid.',\n      invalidRows\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    statusCode: 200,\n    retellPayload: {\n      from_number: '+12629779089',\n      name: requestBody.name || 'Dashboard CSV outbound call batch',\n      tasks\n    }\n  }\n}];"
      },

                      "parameters":  {
                                         "jsCode":  "const requestBody = $json.body || $json;\nconst contacts = requestBody.contacts;\n\nif (!Array.isArray(contacts)) {\n  return [{\n    json: {\n      ok: false,\n      statusCode: 400,\n      error: \u0027Request must include contacts as an array.\u0027,\n      invalidRows: []\n    }\n  }];\n}\n\nif (contacts.length === 0) {\n  return [{\n    json: {\n      ok: false,\n      statusCode: 400,\n      error: \u0027Contacts array cannot be empty.\u0027,\n      invalidRows: []\n    }\n  }];\n}\n\nconst normalizePhone = (value) =\u003e String(value || \u0027\u0027).trim().replace(/[\\s().-]/g, \u0027\u0027);\nconst invalidRows = [];\nconst tasks = [];\n\ncontacts.forEach((contact, index) =\u003e {\n  const phoneNumber = normalizePhone(contact.phoneNumber || contact.phone_number || contact.phone || contact.number);\n  const firstName = String(contact.firstName || contact.first_name || \u0027\u0027).trim();\n  const lastName = String(contact.lastName || contact.last_name || \u0027\u0027).trim();\n  const fullName = `${firstName} ${lastName}`.trim();\n\n  if (!phoneNumber) {\n    invalidRows.push({ row: index + 1, reason: \u0027Missing phone number.\u0027 });\n    return;\n  }\n\n  if (!/^\\+[1-9]\\d{6,14}$/.test(phoneNumber)) {\n    invalidRows.push({\n      row: index + 1,\n      phoneNumber,\n      reason: \u0027Phone number must be E.164 format, for example +14165551234.\u0027\n    });\n    return;\n  }\n\n  tasks.push({\n    to_number: phoneNumber,\n    retell_llm_dynamic_variables: {\n      first_name: firstName,\n      last_name: lastName,\n      name: fullName\n    },\n    metadata: {\n      source: \u0027recoup-health-dashboard-csv\u0027,\n      first_name: firstName,\n      last_name: lastName\n    }\n  });\n});\n\nif (invalidRows.length \u003e 0) {\n  return [{\n    json: {\n      ok: false,\n      statusCode: 400,\n      error: \u0027Some contacts are invalid.\u0027,\n      invalidRows\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    statusCode: 200,\n    retellPayload: {\n      from_number: \u0027+18257823854\u0027,\n      name: requestBody.name || \u0027Recoup Health CSV outbound call batch\u0027,\n      tasks\n    }\n  }\n}];"
                                     },
